
<article class="carte">
    <a href="{{ path('app_livre', {id: livre.id}) }}"
       class="carte-couverture">

        {% if livre.couverture %}
            <img src="{{ livre.couverture }}" alt="{{ livre.titre }}">
        {% else %}
            <img src="https://placehold.co/400x600?text=Livre"
                 alt="{{ livre.titre }}">
        {% endif %}

        {% if livre.estDisponible %}
            <span class="badge badge-disponible">
                {{ livre.exemplairesDisponibles }}
                / {{ livre.exemplaires }} disponible{{ livre.exemplaires > 1 ? 's' }}
            </span>
        {% else %}
            <span class="badge badge-indisponible">
                Indisponible
            </span>
        {% endif %}
    </a>

    <div class="carte-contenu">
        <span class="genre">{{ livre.genre }}</span>
        <h2 class="carte-titre">{{ livre.titre }}</h2>
        <p class="carte-auteur">{{ livre.auteur }}</p>

        <div class="carte-bas">
            <span class="carte-annee">{{ livre.annee }}</span>
            <a href="{{ path('app_livre', {id: livre.id}) }}"
               class="bouton bouton-petit">
                Voir
            </a>

        </div>

    </div>

</article>
